<?xml version="1.0" encoding="utf-8"?>
<!--
  The Knit watch face: a Watch Face Format v4 face, resources only (ADR 2026-10.3y2s). The system renders
  res/raw/watchface.xml, generated by scripts/gen-watchface.py; the link ring and the top slot are fed by
  :wear's complication sources, which list this package as a safe watch face.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- A WFF face carries no code. -->
    <application
        android:hasCode="false"
        android:label="@string/watch_face_name">
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="4" />
    </application>
</manifest>
