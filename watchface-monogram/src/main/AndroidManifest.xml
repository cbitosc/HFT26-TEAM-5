<?xml version="1.0" encoding="utf-8"?>
<!--
  The Knit monogram: an analog Watch Face Format v4 face, resources only (ADR 2026-10.3y2s's amendment). The
  system renders res/raw/watchface.xml, generated by scripts/gen-watchface.py; its left slot defaults to :wear's
  Nearby source, which lists this package as a safe watch face.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- A WFF face carries no code. -->
    <application
        android:hasCode="false"
        android:label="@string/watch_face_name">
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="4" />
    </application>
</manifest>
