#!/bin/sh
# Git LFS's own pre-push hook: it uploads the LFS objects a push's commits point at. Without it the remote
# gets the pointers and never the images, and every other clone's `git lfs pull` fails on them.
#
# `git lfs install` writes this hook into .git/hooks, which `core.hooksPath` replaces wholesale — so the
# copy has to live here too, or opting into the repo's hooks would silently drop it. LFS holds only the
# Compose preview screenshot references (see .gitattributes); nothing on the release path needs it, so a
# machine without git-lfs passes through instead of being blocked.
#
# Active only while `core.hooksPath` points at this directory (see CONTRIBUTING.md).
command -v git-lfs >/dev/null 2>&1 || exit 0
exec git lfs pre-push "$@"
