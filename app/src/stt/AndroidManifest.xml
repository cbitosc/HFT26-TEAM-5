<?xml version="1.0" encoding="utf-8"?>
<!-- What a build with speech adds to the manifest (transcripts and live captions, docs/VOICE_CALLS.md C-3.11-9). Not a
     source set: the build adds this file to a variant only where `BuildConfig.STT` is on (`-Pstt=`; on in debug, off in
     a shipped artifact, and off wherever both call kinds are). The model downloads on a dataSync service, so it outlasts
     the call it was started on. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <service
            android:name="app.getknit.knit.ui.call.stt.SttDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
